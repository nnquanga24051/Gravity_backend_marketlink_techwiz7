{
	"info": {
		"_postman_id": "marketlink-api-collection",
		"name": "MarketLink API & JWT Test Suite",
		"description": "Bộ sưu tập kiểm thử toàn diện API, JWT và Phân quyền RBAC (Spring Boot WebFlux + R2DBC)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081",
			"type": "string"
		},
		{
			"key": "jwtToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. [POST] Lấy Token & Đăng Ký",
			"item": [
				{
					"name": "POST - Đăng Nhập (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('jwtToken', jsonData.token);",
									"    console.log('Saved jwtToken:', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"farmer@marketlink.vn\",\n  \"password\": \"Farmer@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "POST - Đăng Ký Nông Dân (FARMER)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('jwtToken', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"farmer_new@marketlink.vn\",\n  \"password\": \"Farmer@123\",\n  \"fullName\": \"Nông Dân Ba Đình\",\n  \"phoneNumber\": \"0912345678\",\n  \"role\": \"FARMER\",\n  \"stallName\": \"Sạp Rau Củ Hữu Cơ\",\n  \"farmAddress\": \"Đông Anh, Hà Nội\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "POST - Đăng Ký Khách Hàng (CUSTOMER)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('jwtToken', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"customer_new@gmail.com\",\n  \"password\": \"Customer@123\",\n  \"fullName\": \"Khách Hàng Mới\",\n  \"phoneNumber\": \"0987654321\",\n  \"role\": \"CUSTOMER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. [GET] Kiểm Tra Xác Thực JWT (/me)",
			"item": [
				{
					"name": "GET - Token HỢP LỆ (Kỳ vọng: 200 OK)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						}
					},
					"response": []
				},
				{
					"name": "GET - KHÔNG có Token (Kỳ vọng: 401 Unauthorized)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						}
					},
					"response": []
				},
				{
					"name": "GET - Token GIẢ MẠO / Sai Chữ Ký (Kỳ vọng: 401 Unauthorized)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbiJ9.FAKE_SIGNATURE_12345",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. [GET] Kiểm Tra Phân Quyền RBAC Theo Vai Trò",
			"item": [
				{
					"name": "GET - Khu vực Nông Dân (/api/farmer/**)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/farmer/dashboard",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"farmer",
								"dashboard"
							]
						},
						"description": "Chỉ tài khoản có ROLE_FARMER mới nhận được 200 OK. Khách hàng gọi sẽ bị 403 Forbidden."
					},
					"response": []
				},
				{
					"name": "GET - Khu vực Khách Hàng (/api/customer/**)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/customer/profile-summary",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"customer",
								"profile-summary"
							]
						},
						"description": "Chỉ tài khoản có ROLE_CUSTOMER mới nhận được 200 OK. Nông dân gọi sẽ bị 403 Forbidden."
					},
					"response": []
				},
				{
					"name": "GET - Khu vực Quản Trị Viên (/api/admin/**)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/admin/system-status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"system-status"
							]
						},
						"description": "Chỉ tài khoản có ROLE_ADMIN mới nhận được 200 OK. User thường gọi sẽ bị 403 Forbidden."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. [GET] API Công Khai (Không cần Token)",
			"item": [
				{
					"name": "GET - Danh Sách Danh Mục Hàng (/api/categories)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/categories",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"categories"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}
