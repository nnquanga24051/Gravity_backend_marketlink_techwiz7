# ===================================================================
# 🚀 MARKETLINK BACKEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế của bạn:
# cp .env.example .env
# ===================================================================

# -------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# -------------------------------------------------------------------
PORT=8081

# -------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Reactive R2DBC MySQL)
# -------------------------------------------------------------------
DB_URL=r2dbc:mysql://localhost:3306/marketlink_db
DB_USERNAME=root
DB_PASSWORD=
SQL_INIT_MODE=never

# -------------------------------------------------------------------
# 3. SECURITY & JWT CONFIGURATION
# -------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ISSUER=http://localhost:8081
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# -------------------------------------------------------------------
# 4. GOOGLE GEMINI AI ASSISTANT
# -------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# -------------------------------------------------------------------
# 5. FILE & IMAGE UPLOADS
# -------------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_BASE_URL=http://localhost:8081

# -------------------------------------------------------------------
# 6. EMAIL NOTIFICATION & OTP (SMTP Gmail)
# -------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password

# -------------------------------------------------------------------
# 7. VPS DEPLOYMENT SETTINGS (Optional)
# -------------------------------------------------------------------
VPS_HOST=your_vps_ip_address
VPS_USER=root
VPS_PASS=your_vps_password
